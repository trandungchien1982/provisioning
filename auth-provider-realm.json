{
  "id": "auth-provider-realm",
  "realm": "auth-provider-realm",
  "enabled": true,
  "displayName": "Auth + Authorization Provider",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Administrator role" },
      { "name": "test", "description": "Testing role" },
      { "name": "normal", "description": "Normal user role" },
      { "name": "moderator", "description": "Moderator role" }
    ]
  },
  "clients": [
    {
      "clientId": "oauth2-app",
      "name": "OAuth2 / OIDC Test Client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "oauth2-app-secret-please-change",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8081/*",
        "http://127.0.0.1:3000/*",
        "http://127.0.0.1:8081/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8081",
        "http://127.0.0.1:3000",
        "http://127.0.0.1:8081"
      ],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false",
        "post.logout.redirect.uris": "+",
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["profile", "email", "roles"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    },
    {
      "clientId": "saml-app",
      "name": "SAML2 Test Client",
      "enabled": true,
      "protocol": "saml",
      "redirectUris": [
        "http://localhost:8090/*",
        "http://127.0.0.1:8090/*"
      ],
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.server.signature": "true",
        "saml.force.post.binding": "true",
        "saml_name_id_format": "username",
        "saml.authnstatement": "true",
        "saml.client.signature": "false",
        "saml.encrypt": "false"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "attribute.name": "username",
            "attribute.nameformat": "Basic",
            "user.attribute": "username",
            "friendly.name": "username"
          }
        },
        {
          "name": "realm roles",
          "protocol": "saml",
          "protocolMapper": "saml-role-list-mapper",
          "consentRequired": false,
          "config": {
            "attribute.name": "Role",
            "attribute.nameformat": "Basic",
            "single": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "user1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "OAuth2",
      "lastName": "AdminTester",
      "credentials": [
        {
          "type": "password",
          "value": "pwd1",
          "temporary": false
        }
      ],
      "realmRoles": ["admin", "test"]
    },
    {
      "username": "user2",
      "enabled": true,
      "emailVerified": true,
      "firstName": "SAML2",
      "lastName": "NormalModerator",
      "credentials": [
        {
          "type": "password",
          "value": "pwd2",
          "temporary": false
        }
      ],
      "realmRoles": ["normal", "moderator"]
    }
  ]
}
